# Two LangSmith credentials, NOT interchangeable:
#   lsv2_pt_  workspace key — tracing, datasets, experiments
#   lsv2_sk_  gateway key   — pays for model calls
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=fleet-sql

# Model, through the LangSmith gateway so no provider secret is needed.
LANGSMITH_API_KEY_GATEWAY=lsv2_sk_...
OPENAI_API_KEY=lsv2_sk_...
OPENAI_BASE_URL=https://gateway.smith.langchain.com/openai/v1
MODEL_ID=gpt-5.6-terra
JUDGE_MODEL=gpt-5.6-terra

# v1 = naive inline rows; v2 = receipts + targeted result tools.
AGENT_VARIANT=v2
APP_ENVIRONMENT=demo

# Scopes dataset and project names so two demoers do not collide.
DEMO_PRESENTER=robert
